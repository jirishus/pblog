server {
    
    location /hello/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;  # Optional: Disables SSL certificate verification between Nginx and the upstream server.
    }

    location /api/data/ {
        proxy_pass http://127.0.0.1:3000;
	    proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;  # Optional: Disables SSL certificate verification between Nginx and the upstream server.
    }

    location / {
        # Serve your website files (e.g., index.html)
        root /var/www/html;
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/brandongagon.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/brandongagon.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = www.brandongagon.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = brandongagon.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name brandongagon.com www.brandongagon.com;
    return 404; # managed by Certbot
}
